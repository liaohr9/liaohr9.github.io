---
import config from 'virtual:config'

import { Icon } from '../user'
---

<header-component
  class='group sticky top-4 z-50 max-md:z-30 mb-12 flex items-center justify-between rounded-xl border border-transparent max-sm:py-1 sm:rounded-2xl'
>
  <span class='header-glass-material' aria-hidden='true'>
    <span class='header-glass-optics'></span>
    <span class='header-glass-tint'></span>
  </span>
  <a
    class='z-30 whitespace-nowrap text-xl max-sm:text-base font-semibold group-[.not-top]:ms-2 sm:group-[.not-top]:ms-3'
    style='transition:margin-inline 0.3s'
    href='/'
    aria-label='Brand'>{config.title}</a
  >

  <div class='flex items-center gap-x-2'>
    {/* Menu links */}
    <div
      id='headerExpandContent'
      class='end-0 start-0 top-12 grid border border-transparent group-[.not-top]:rounded-xl group-[.expanded]:opacity-100 dark:group-[.expanded.not-top]:bg-muted max-sm:absolute max-sm:opacity-0 max-sm:group-[.not-top]:border-border max-sm:group-[.expanded.not-top]:bg-background max-sm:group-[.not-top]:px-4 max-sm:group-[.not-top]:py-2 sm:grid-rows-1'
    >
      <div class='flex flex-col items-center justify-center overflow-hidden sm:flex-row'>
        {
          config.header.menu.map((item) => (
            <a
              href={item.link}
              class='w-full flex-none grow py-2 text-right font-medium transition-none hover:text-primary sm:w-fit sm:px-3'
              aria-label='Nav menu item'
            >
              {item.title}
            </a>
          ))
        }
        <div class='flex w-full grow flex-row justify-end gap-x-3 sm:w-fit sm:gap-x-5'>
          <a class='px-1 py-2 transition-none sm:px-2' href='/search' title='Search'>
            <span class='sr-only'>Search</span>
            <Icon name='search' class='size-5' />
          </a>
        </div>
      </div>
    </div>

    {/* buttons */}
    <div class='z-30 flex gap-x-4 group-[.not-top]:gap-x-2' style='transition:gap 0.3s'>
      <button
        id='toggleDarkMode'
        class='group/dark box-content size-5 rounded-md border border-transparent p-1.5 transition-colors hover:bg-border sm:group-[.not-top]:rounded-xl'
      >
        <span class='sr-only'>Dark Theme</span>
        <Icon class='system size-5 group-hover/dark:text-primary' name='computer' />
        <Icon class='light hidden size-5 group-hover/dark:text-primary' name='sun' />
        <Icon class='dark hidden size-5 group-hover/dark:text-primary' name='moon' />
      </button>
      <button
        id='toggleMenu'
        class='rounded-md border p-1.5 transition-colors hover:bg-border sm:hidden sm:group-[.not-top]:rounded-xl'
      >
        <span class='sr-only'>Menu</span>
        <Icon class='size-5' name='menu' />
      </button>
    </div>
  </div>
</header-component>

{/* Use inline to load icon quicker firstly */}
<script is:inline>
  const toggleDarkModeElement = document.getElementById('toggleDarkMode')
  if (toggleDarkModeElement) {
    toggleDarkModeElement.dataset.theme = localStorage.getItem('theme') || 'system'
  }
</script>
<script>
  import { setupHeaderGlass } from '../../libs/liquid-glass/header-glass'
  import { setupHeaderScroll } from '../../libs/liquid-glass/header-scroll'
  import { setTheme, showToast } from '../../utils'

  class HeaderComponent extends HTMLElement {
    private cleanupGlass?: () => void
    private cleanupScroll?: () => void
    private events?: AbortController

    connectedCallback() {
      this.events?.abort()
      this.events = new AbortController()
      const { signal } = this.events
      this.cleanupGlass?.()
      this.cleanupScroll?.()
      this.cleanupScroll = setupHeaderScroll(this)
      this.cleanupGlass = setupHeaderGlass(this)

      // Dark Mode
      const darkModeBtn = this.querySelector('#toggleDarkMode') as HTMLElement
      darkModeBtn.addEventListener(
        'click',
        () => {
          const newTheme = setTheme(undefined, true)
          darkModeBtn.dataset.theme = newTheme
          showToast({ message: `Set theme to ${newTheme}` })
        },
        { signal }
      )

      this.querySelector('#toggleMenu')?.addEventListener(
        'click',
        () => this.classList.toggle('expanded'),
        { signal }
      )
    }

    disconnectedCallback() {
      this.events?.abort()
      this.cleanupGlass?.()
      this.cleanupScroll?.()
    }
  }

  customElements.define('header-component', HeaderComponent)
</script>

<style>
  header-component {
    /* Keep the document footprint identical before/after the floating threshold. */
    min-height: 3.5rem;
    transition:
      padding 0.3s,
      transform 0.3s,
      margin-inline 0.3s,
      border 0.15s,
      background-color 0.15s;

    &.not-top {
      border-color: var(--glass-border);
      background-color: var(--glass-fallback);
      padding-left: 0.375rem;
      padding-right: 0.375rem;
      box-shadow: var(--glass-shadow);
    }
    &[data-show='false']:not(.expanded) {
      transform: translateY(-5rem);
    }
  }
  @media (min-width: 800px) {
    header-component.not-top {
      margin-inline: 8%;
    }
  }
  /* Shared material tokens also tint the expanded mobile menu. */
  header-component {
    --glass-fallback: hsl(var(--background) / 0.97);
    --glass-tint: rgb(255 255 255 / 0.6);
    --glass-border: rgb(255 255 255 / 0.5);
    --glass-sheen: linear-gradient(
      165deg,
      rgb(255 255 255 / 0.16),
      transparent 28%,
      transparent 72%,
      rgb(255 255 255 / 0.07)
    );
    --glass-shadow:
      inset 0 1px 1px rgb(255 255 255 / 0.8), inset 1px 0 1px rgb(255 255 255 / 0.22),
      inset 0 -1px 0 rgb(255 255 255 / 0.16), 0 0 0 1px rgb(24 24 27 / 0.05),
      0 8px 24px -10px rgb(24 24 27 / 0.2);
  }

  :global(.dark) header-component {
    --glass-fallback: hsl(var(--muted) / 0.97);
    --glass-tint: rgb(42 50 64 / 0.75);
    --glass-border: rgb(255 255 255 / 0.36);
    --glass-sheen: linear-gradient(
      165deg,
      rgb(255 255 255 / 0.12),
      transparent 28%,
      transparent 72%,
      rgb(255 255 255 / 0.04)
    );
    --glass-shadow:
      inset 0 1px 1px rgb(255 255 255 / 0.6), inset 1px 0 1px rgb(255 255 255 / 0.16),
      inset 0 -1px 0 rgb(255 255 255 / 0.04), 0 0 0 1px rgb(0 0 0 / 0.12),
      0 10px 28px -10px rgb(0 0 0 / 0.28);
  }

  /* Keep optics and tint below live controls so text stays sharp. */
  .header-glass-material {
    position: absolute;
    inset: -1px;
    z-index: -1;
    border-radius: inherit;
    overflow: hidden;
    pointer-events: none;
    visibility: hidden;
  }

  .header-glass-optics,
  .header-glass-tint {
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .header-glass-optics {
    -webkit-backdrop-filter: blur(5px) saturate(1.05);
    backdrop-filter: blur(5px) saturate(1.05);
  }

  .header-glass-tint {
    background-color: var(--glass-tint);
    background-image: var(--glass-sheen);
    box-shadow:
      inset 0 1px 1px rgb(255 255 255 / 0.5),
      inset 0 -1px 1px rgb(255 255 255 / 0.16);
  }

  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    header-component.not-top {
      background-color: transparent;
    }
    header-component.not-top .header-glass-material {
      visibility: visible;
    }
  }

  /* Original optical map, tuned for readable navigation over busy photographs. */
  header-component.not-top[data-glass-engine='author-refraction'] {
    border-color: transparent;
    border-radius: 150px;
    box-shadow: none;
  }
  header-component[data-glass-engine='author-refraction'] .header-glass-material {
    border-radius: 150px;
    box-shadow:
      0 6px 20px rgb(0 0 0 / 0.16),
      inset 0 1px 0 rgb(255 255 255 / 0.3);
  }
  header-component[data-glass-engine='author-refraction'] .header-glass-tint {
    background-image: linear-gradient(135deg, rgb(255 255 255 / 0.08), transparent 45%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.24);
  }
  header-component.not-top {
    color: #111827;
  }
  :global(.dark) header-component.not-top {
    color: #f8fafc;
  }

  header-component.not-top > a,
  header-component.not-top #headerExpandContent a,
  header-component.not-top button,
  header-component.expanded #headerExpandContent a {
    text-shadow: 0 1px 2px rgb(255 255 255 / 0.45);
  }

  :global(.dark) header-component.not-top > a,
  :global(.dark) header-component.not-top #headerExpandContent a,
  :global(.dark) header-component.not-top button,
  :global(.dark) header-component.expanded #headerExpandContent a {
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.65);
  }

  header-component a:focus-visible,
  header-component button:focus-visible {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 3px;
    border-radius: 0.5rem;
  }

  /* header menu */
  @media (max-width: 640px) {
    #headerExpandContent {
      grid-template-rows: 0fr;
      transition:
        opacity 0.3s,
        padding 0.3s,
        border-color 0.15s,
        grid-template-rows 0.3s;
    }
    .expanded #headerExpandContent {
      grid-template-rows: 1fr;
    }
    /* Override utility backgrounds in both top and scrolled states. */
    header-component.expanded #headerExpandContent,
    :global(.dark) header-component.expanded #headerExpandContent {
      border-color: var(--glass-border);
      border-radius: 0.875rem;
      background-color: var(--glass-fallback);
      box-shadow: var(--glass-shadow);
    }

    @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
      header-component.expanded #headerExpandContent,
      :global(.dark) header-component.expanded #headerExpandContent {
        background-color: var(--glass-tint);
        background-image: var(--glass-sheen);
        -webkit-backdrop-filter: blur(5px) saturate(1.05);
        backdrop-filter: blur(5px) saturate(1.05);
      }
    }
  }

  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
    header-component.not-top {
      background-color: var(--glass-fallback);
    }
    header-component.not-top .header-glass-material {
      visibility: hidden;
    }
    header-component.expanded #headerExpandContent,
    :global(.dark) header-component.expanded #headerExpandContent {
      background: var(--glass-fallback);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    header-component,
    header-component .header-glass-material,
    #headerExpandContent {
      transition: none;
    }
  }

  /* dark light mode toggle */
  #toggleDarkMode {
    &[data-theme='dark'] {
      & .system {
        display: none;
      }
      & .dark {
        display: block;
      }
    }
    &[data-theme='light'] {
      & .system {
        display: none;
      }
      .light {
        display: block;
      }
    }
  }
</style>
