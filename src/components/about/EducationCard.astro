---
import { Image } from 'astro:assets'

interface Props {
  logo?: ImageMetadata
  school: string
  degree: string
  period: string
  grades?: string
  link?: string
}

const { logo, school, degree, period, grades, link } = Astro.props
---

<article class='education-card group relative overflow-hidden rounded-2xl border bg-background transition-all hover:border-foreground/25 hover:shadow-lg'>
  <div class='flex flex-col md:flex-row min-h-[200px]'>
    {/* 左侧校徽 */}
    {logo && (
      <div class='flex-shrink-0 w-48 h-48 mx-auto md:w-56 md:h-auto md:mx-0 lg:w-64'>
        <div class='md:h-full bg-muted flex items-center justify-center p-8'>
          <Image
            src={logo}
            alt={school}
            class='max-h-full max-w-full object-contain'
            loading='lazy'
          />
        </div>
      </div>
    )}

    {/* 右侧内容 */}
    <div class='flex flex-1 flex-col justify-center p-6 md:p-8'>
      {/* 学校名称 */}
      {link ? (
        <a href={link} target='_blank' rel='noopener noreferrer' class='block'>
          <h3 class='mb-3 text-xl font-bold text-foreground transition-colors group-hover:text-primary md:text-2xl'>
            {school}
          </h3>
        </a>
      ) : (
        <h3 class='mb-3 text-xl font-bold text-foreground md:text-2xl'>
          {school}
        </h3>
      )}

      {/* 学位 */}
      <p class='mb-2 text-base text-muted-foreground'>
        {degree}
      </p>

      {/* 时间 */}
      <p class='mb-2 text-base text-muted-foreground'>
        {period}
      </p>

      {/* 成绩 */}
      {grades && (
        <p class='text-base text-muted-foreground'>
          <span class='font-medium'>Grades:</span> {grades}
        </p>
      )}
    </div>
  </div>
</article>
