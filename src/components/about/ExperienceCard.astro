---
import { Image } from 'astro:assets'

interface Props {
  logo?: ImageMetadata
  title: string
  org: string
  period: string
  advisor?: string
  highlights?: string[]
  link?: string
}

const { logo, title, org, period, advisor, highlights, link } = Astro.props
---

<article class='education-card group relative overflow-hidden rounded-2xl border bg-background transition-all hover:border-foreground/25 hover:shadow-lg'>
  <div class='flex flex-col md:flex-row min-h-[200px]'>
    {/* 左侧实验室/公司logo或照片 */}
    {logo && (
      <div class='flex-shrink-0 w-48 h-48 mx-auto md:w-56 md:h-auto md:mx-0 lg:w-64'>
        <div class='md:h-full bg-muted flex items-center justify-center p-8'>
          <Image
            src={logo}
            alt={org}
            class='max-h-full max-w-full object-contain'
            loading='lazy'
          />
        </div>
      </div>
    )}

    {/* 右侧内容 */}
    <div class='flex flex-1 flex-col justify-center p-6 md:p-8'>
      {/* 标题/职位 */}
      <h3 class='mb-3 text-xl font-bold text-foreground md:text-2xl'>
        {title}
      </h3>
      {/* 机构/实验室 */}
      {link ? (
        <a href={link} target='_blank' rel='noopener noreferrer' class='block'>
          <p class='mb-2 text-base font-semibold text-muted-foreground md:text-lg'>{org}</p>
        </a>
      ) : (
        <p class='mb-2 text-base font-semibold text-muted-foreground md:text-lg'>{org}</p>
      )}
      {/* 时间 */}
      <p class='mb-2 text-base text-muted-foreground'>{period}</p>
      {/* 导师 */}
      {advisor && (
        <p class='mb-2 text-base text-muted-foreground'>Advisor: {advisor}</p>
      )}
      {/* 亮点/内容 */}
      {highlights && highlights.length > 0 && (
        <ul class='space-y-2'>
          {highlights.map((highlight) => (
            <li class='flex items-start gap-2 text-sm text-muted-foreground'>
              <span class='mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-primary'></span>
              <span>{highlight}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</article>
