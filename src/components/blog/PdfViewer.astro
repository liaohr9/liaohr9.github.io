---
interface Props {
  src: string
  title?: string
  caption?: string
  height?: string
  initialPage?: number
  initialScale?: number | 'fit-width'
}

const {
  src,
  title = 'PDF document',
  caption,
  height = 'min(78vh, 760px)',
  initialPage = 1,
  initialScale = 'fit-width'
} = Astro.props
---

<figure class='pdf-viewer not-prose' style={`--pdf-viewer-height: ${height};`}>
  <pdf-js-viewer
    data-src={src}
    data-title={title}
    data-initial-page={String(initialPage)}
    data-initial-scale={String(initialScale)}
  >
    <div class='pdf-viewer__toolbar'>
      <div class='pdf-viewer__title'>
        <span>{title}</span>
        <span class='pdf-viewer__meta' data-pdf-scale-label>Loading...</span>
      </div>

      <div class='pdf-viewer__controls' aria-label='PDF controls'>
        <button
          type='button'
          data-pdf-prev
          aria-label='Previous page'
          title='Previous page'
          disabled
        >
          &lt;
        </button>
        <label class='pdf-viewer__page'>
          <span class='sr-only'>Page</span>
          <input
            data-pdf-page-input
            type='number'
            min='1'
            value={initialPage}
            inputmode='numeric'
          />
          <span>/</span>
          <span data-pdf-page-count>...</span>
        </label>
        <button type='button' data-pdf-next aria-label='Next page' title='Next page' disabled>
          &gt;
        </button>

        <span class='pdf-viewer__divider' aria-hidden='true'></span>

        <button type='button' data-pdf-zoom-out aria-label='Zoom out' title='Zoom out' disabled>
          -
        </button>
        <button type='button' data-pdf-fit aria-label='Fit width' title='Fit width' disabled>
          Fit
        </button>
        <button type='button' data-pdf-zoom-in aria-label='Zoom in' title='Zoom in' disabled>
          +
        </button>
        <button type='button' data-pdf-rotate aria-label='Rotate page' title='Rotate page' disabled>
          Rotate
        </button>
      </div>
    </div>

    <div class='pdf-viewer__status' data-pdf-status role='status' aria-live='polite'>
      Loading PDF...
    </div>

    <div class='pdf-viewer__stage' data-pdf-stage tabindex='0' aria-label={`${title} pages`}>
      <div class='pdf-viewer__pages' data-pdf-pages></div>
    </div>
  </pdf-js-viewer>

  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  import {
    getDocument,
    GlobalWorkerOptions,
    type PDFDocumentLoadingTask,
    type PDFDocumentProxy,
    type RenderTask
  } from 'pdfjs-dist'
  import workerSrc from 'pdfjs-dist/build/pdf.worker.mjs?url'

  GlobalWorkerOptions.workerSrc = workerSrc

  const MIN_SCALE = 0.35
  const MAX_SCALE = 4
  const DEVICE_PIXEL_RATIO_LIMIT = 2
  const LAZY_RENDER_MARGIN = '900px 0px'
  const NEARBY_PAGE_RADIUS = 1

  const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value))
  const pageNumbers = (count: number) => Array.from({ length: count }, (_, index) => index + 1)

  class PdfJsViewer extends HTMLElement {
    private loadingTask: PDFDocumentLoadingTask | null = null
    private pdf: PDFDocumentProxy | null = null
    private abortController: AbortController | null = null
    private resizeObserver: ResizeObserver | null = null
    private pageObserver: IntersectionObserver | null = null
    private resizeTimer = 0
    private scrollRaf = 0
    private renderSequence = 0
    private layoutSequence = 0
    private initialized = false

    private src = ''
    private documentTitle = 'PDF document'
    private pageNumber = 1
    private pageCount = 0
    private scale = 1
    private scaleMode: 'fit-width' | 'custom' = 'fit-width'
    private rotation = 0

    private visiblePages = new Set<number>()
    private renderingPages = new Set<number>()
    private renderedPageKeys = new Map<number, string>()
    private renderTasks = new Map<number, RenderTask>()
    private pageWrappers = new Map<number, HTMLElement>()
    private pageCanvases = new Map<number, HTMLCanvasElement>()

    private pagesEl: HTMLElement | null = null
    private stage: HTMLElement | null = null
    private statusEl: HTMLElement | null = null
    private pageInput: HTMLInputElement | null = null
    private pageCountEl: HTMLElement | null = null
    private scaleLabel: HTMLElement | null = null
    private prevButton: HTMLButtonElement | null = null
    private nextButton: HTMLButtonElement | null = null
    private zoomOutButton: HTMLButtonElement | null = null
    private zoomInButton: HTMLButtonElement | null = null
    private fitButton: HTMLButtonElement | null = null
    private rotateButton: HTMLButtonElement | null = null

    connectedCallback() {
      if (this.initialized) return
      this.initialized = true
      this.abortController = new AbortController()

      this.src = this.dataset.src ?? ''
      this.documentTitle = this.dataset.title ?? this.documentTitle
      this.pageNumber = Math.max(1, Number.parseInt(this.dataset.initialPage ?? '1', 10) || 1)

      const initialScale = this.dataset.initialScale ?? 'fit-width'
      if (initialScale !== 'fit-width') {
        const parsedScale = Number.parseFloat(initialScale)
        if (Number.isFinite(parsedScale)) {
          this.scale = clamp(parsedScale, MIN_SCALE, MAX_SCALE)
          this.scaleMode = 'custom'
        }
      }

      this.pagesEl = this.querySelector<HTMLElement>('[data-pdf-pages]')
      this.stage = this.querySelector<HTMLElement>('[data-pdf-stage]')
      this.statusEl = this.querySelector<HTMLElement>('[data-pdf-status]')
      this.pageInput = this.querySelector<HTMLInputElement>('[data-pdf-page-input]')
      this.pageCountEl = this.querySelector<HTMLElement>('[data-pdf-page-count]')
      this.scaleLabel = this.querySelector<HTMLElement>('[data-pdf-scale-label]')
      this.prevButton = this.querySelector<HTMLButtonElement>('[data-pdf-prev]')
      this.nextButton = this.querySelector<HTMLButtonElement>('[data-pdf-next]')
      this.zoomOutButton = this.querySelector<HTMLButtonElement>('[data-pdf-zoom-out]')
      this.zoomInButton = this.querySelector<HTMLButtonElement>('[data-pdf-zoom-in]')
      this.fitButton = this.querySelector<HTMLButtonElement>('[data-pdf-fit]')
      this.rotateButton = this.querySelector<HTMLButtonElement>('[data-pdf-rotate]')

      this.bindEvents()
      void this.load()
    }

    disconnectedCallback() {
      window.clearTimeout(this.resizeTimer)
      if (this.scrollRaf) window.cancelAnimationFrame(this.scrollRaf)
      this.abortController?.abort()
      this.resizeObserver?.disconnect()
      this.pageObserver?.disconnect()
      this.cancelRenderTasks()
      void this.loadingTask?.destroy()
      this.loadingTask = null
      this.pdf = null
    }

    private bindEvents() {
      const signal = this.abortController?.signal
      if (!signal) return

      this.prevButton?.addEventListener('click', () => void this.goToPage(this.pageNumber - 1), {
        signal
      })
      this.nextButton?.addEventListener('click', () => void this.goToPage(this.pageNumber + 1), {
        signal
      })
      this.zoomOutButton?.addEventListener('click', () => void this.setScale(this.scale / 1.15), {
        signal
      })
      this.zoomInButton?.addEventListener('click', () => void this.setScale(this.scale * 1.15), {
        signal
      })
      this.fitButton?.addEventListener('click', () => void this.fitWidth(), { signal })
      this.rotateButton?.addEventListener('click', () => void this.rotate(), { signal })

      this.pageInput?.addEventListener(
        'change',
        () => {
          const nextPage = Number.parseInt(this.pageInput?.value ?? '', 10)
          if (Number.isFinite(nextPage)) void this.goToPage(nextPage)
        },
        { signal }
      )

      this.stage?.addEventListener('scroll', () => this.scheduleCurrentPageUpdate(), { signal })

      this.stage?.addEventListener(
        'keydown',
        (event) => {
          if (event.key === 'ArrowLeft' || event.key === 'PageUp') {
            event.preventDefault()
            void this.goToPage(this.pageNumber - 1)
          }
          if (event.key === 'ArrowRight' || event.key === 'PageDown') {
            event.preventDefault()
            void this.goToPage(this.pageNumber + 1)
          }
          if (event.key === 'Home') {
            event.preventDefault()
            void this.goToPage(1)
          }
          if (event.key === 'End') {
            event.preventDefault()
            void this.goToPage(this.pageCount)
          }
        },
        { signal }
      )

      if (this.stage) {
        this.resizeObserver = new ResizeObserver(() => {
          if (!this.pdf) return
          window.clearTimeout(this.resizeTimer)
          this.resizeTimer = window.setTimeout(
            () => void this.refreshPages({ keepCurrentPage: true }),
            160
          )
        })
        this.resizeObserver.observe(this.stage)
      }
    }

    private async load() {
      if (!this.src) {
        this.setError('Missing PDF source.')
        return
      }
      if (!this.pagesEl || !this.stage) {
        this.setError('PDF viewer markup is incomplete.')
        return
      }

      this.setBusy(true)
      this.setStatus('Loading PDF...')

      try {
        this.loadingTask = getDocument({ url: this.src })
        this.pdf = await this.loadingTask.promise
        this.pageCount = this.pdf.numPages
        this.pageNumber = clamp(this.pageNumber, 1, this.pageCount)

        if (this.pageInput) {
          this.pageInput.max = String(this.pageCount)
          this.pageInput.value = String(this.pageNumber)
        }
        if (this.pageCountEl) this.pageCountEl.textContent = String(this.pageCount)

        await this.createPageShells()
        this.setupPageObserver()
        this.setBusy(false)
        this.setStatus(`Page ${this.pageNumber} of ${this.pageCount}`)
        this.scrollToPage(this.pageNumber, false)
        this.renderVisiblePages()
        await this.renderPage(this.pageNumber)
      } catch (error) {
        this.setError(`Failed to load PDF: ${this.formatError(error)}`)
      }
    }

    private async createPageShells() {
      if (!this.pagesEl) return

      this.pageObserver?.disconnect()
      this.visiblePages.clear()
      this.renderedPageKeys.clear()
      this.pageWrappers.clear()
      this.pageCanvases.clear()
      this.pagesEl.replaceChildren()

      const fragment = document.createDocumentFragment()
      for (const pageNumber of pageNumbers(this.pageCount)) {
        const shell = document.createElement('section')
        shell.className = 'pdf-viewer__page-shell'
        shell.dataset.pdfPage = String(pageNumber)
        shell.dataset.rendered = 'false'
        shell.setAttribute('aria-label', `Page ${pageNumber}`)

        const label = document.createElement('div')
        label.className = 'pdf-viewer__page-label'
        label.textContent = `Page ${pageNumber}`

        const canvas = document.createElement('canvas')
        canvas.dataset.pdfCanvas = ''
        canvas.setAttribute('aria-label', `${this.documentTitle} page ${pageNumber}`)

        shell.append(label, canvas)
        fragment.append(shell)
        this.pageWrappers.set(pageNumber, shell)
        this.pageCanvases.set(pageNumber, canvas)
      }

      this.pagesEl.append(fragment)
      await this.updatePageShellSizes()
    }

    private setupPageObserver() {
      this.pageObserver?.disconnect()
      this.visiblePages.clear()

      if (!this.stage || !('IntersectionObserver' in window)) {
        this.pageWrappers.forEach((_, pageNumber) => this.visiblePages.add(pageNumber))
        this.renderVisiblePages()
        return
      }

      this.pageObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const pageNumber = Number.parseInt(
              (entry.target as HTMLElement).dataset.pdfPage ?? '',
              10
            )
            if (!Number.isFinite(pageNumber)) continue

            if (entry.isIntersecting) {
              this.visiblePages.add(pageNumber)
              void this.renderPage(pageNumber)
            } else {
              this.visiblePages.delete(pageNumber)
            }
          }
          this.scheduleCurrentPageUpdate()
          this.renderVisiblePages()
        },
        { root: this.stage, rootMargin: LAZY_RENDER_MARGIN, threshold: 0.01 }
      )

      this.pageWrappers.forEach((wrapper) => this.pageObserver?.observe(wrapper))
    }

    private async updatePageShellSizes() {
      if (!this.pdf) return

      const sequence = ++this.layoutSequence
      for (const pageNumber of pageNumbers(this.pageCount)) {
        const canvas = this.pageCanvases.get(pageNumber)
        if (!canvas) continue

        const page = await this.pdf.getPage(pageNumber)
        if (sequence !== this.layoutSequence) return

        const baseViewport = page.getViewport({ scale: 1, rotation: this.rotation })
        const renderScale = this.getScaleForPage(baseViewport.width)
        const viewport = page.getViewport({ scale: renderScale, rotation: this.rotation })

        if (this.scaleMode === 'fit-width' && pageNumber === this.pageNumber)
          this.scale = renderScale

        canvas.style.width = `${Math.ceil(viewport.width)}px`
        canvas.style.height = `${Math.ceil(viewport.height)}px`
      }

      this.updateControls()
    }

    private renderVisiblePages() {
      if (!this.pdf) return

      const targets = new Set<number>(this.visiblePages)
      targets.add(this.pageNumber)
      for (let offset = 1; offset <= NEARBY_PAGE_RADIUS; offset += 1) {
        targets.add(this.pageNumber - offset)
        targets.add(this.pageNumber + offset)
      }

      Array.from(targets)
        .filter((pageNumber) => pageNumber >= 1 && pageNumber <= this.pageCount)
        .sort((a, b) => a - b)
        .forEach((pageNumber) => void this.renderPage(pageNumber))
    }

    private async renderPage(pageNumber: number) {
      if (!this.pdf || this.renderingPages.has(pageNumber)) return

      const canvas = this.pageCanvases.get(pageNumber)
      const shell = this.pageWrappers.get(pageNumber)
      if (!canvas || !shell) return

      const sequence = this.renderSequence
      this.renderingPages.add(pageNumber)
      shell.dataset.rendered = 'loading'

      try {
        const page = await this.pdf.getPage(pageNumber)
        if (sequence !== this.renderSequence) return

        const baseViewport = page.getViewport({ scale: 1, rotation: this.rotation })
        const renderScale = this.getScaleForPage(baseViewport.width)
        const viewport = page.getViewport({ scale: renderScale, rotation: this.rotation })
        const renderKey = this.getRenderKey(
          pageNumber,
          renderScale,
          viewport.width,
          viewport.height
        )

        if (this.renderedPageKeys.get(pageNumber) === renderKey) {
          shell.dataset.rendered = 'true'
          return
        }

        const context = canvas.getContext('2d')
        if (!context) throw new Error('Canvas is not available.')

        const outputScale = Math.min(window.devicePixelRatio || 1, DEVICE_PIXEL_RATIO_LIMIT)
        canvas.width = Math.floor(viewport.width * outputScale)
        canvas.height = Math.floor(viewport.height * outputScale)
        canvas.style.width = `${viewport.width}px`
        canvas.style.height = `${viewport.height}px`

        const renderTask = page.render({
          canvas,
          canvasContext: context,
          viewport,
          transform: outputScale === 1 ? undefined : [outputScale, 0, 0, outputScale, 0, 0]
        })

        this.renderTasks.set(pageNumber, renderTask)
        await renderTask.promise
        if (sequence !== this.renderSequence) return

        this.renderedPageKeys.set(pageNumber, renderKey)
        shell.dataset.rendered = 'true'
        if (pageNumber === this.pageNumber)
          this.setStatus(`Page ${this.pageNumber} of ${this.pageCount}`)
      } catch (error) {
        if (this.isCancelError(error)) return
        shell.dataset.rendered = 'error'
        this.setError(`Failed to render page ${pageNumber}: ${this.formatError(error)}`)
      } finally {
        this.renderTasks.delete(pageNumber)
        this.renderingPages.delete(pageNumber)
        this.updateControls()
      }
    }

    private async refreshPages(options: { keepCurrentPage?: boolean } = {}) {
      if (!this.pdf) return

      const pageToKeep = this.pageNumber
      this.renderSequence += 1
      this.layoutSequence += 1
      this.cancelRenderTasks()
      this.renderingPages.clear()
      this.renderedPageKeys.clear()
      this.pageWrappers.forEach((shell) => {
        shell.dataset.rendered = 'false'
      })
      this.pageCanvases.forEach((canvas) => {
        canvas.width = 0
        canvas.height = 0
      })

      await this.updatePageShellSizes()
      if (options.keepCurrentPage) this.scrollToPage(pageToKeep, false)
      this.updateControls()
      this.renderVisiblePages()
      void this.renderPage(pageToKeep)
    }

    private async goToPage(page: number) {
      if (!this.pdf) return

      const nextPage = clamp(page, 1, this.pageCount)
      this.pageNumber = nextPage
      this.updateControls()
      this.setStatus(`Page ${this.pageNumber} of ${this.pageCount}`)
      this.scrollToPage(nextPage, true)
      this.renderVisiblePages()
      await this.renderPage(nextPage)
    }

    private async setScale(scale: number) {
      this.scaleMode = 'custom'
      this.scale = clamp(scale, MIN_SCALE, MAX_SCALE)
      await this.refreshPages({ keepCurrentPage: true })
    }

    private async fitWidth() {
      this.scaleMode = 'fit-width'
      await this.refreshPages({ keepCurrentPage: true })
    }

    private async rotate() {
      this.rotation = (this.rotation + 90) % 360
      await this.refreshPages({ keepCurrentPage: true })
    }

    private scrollToPage(pageNumber: number, smooth: boolean) {
      if (!this.stage) return

      const wrapper = this.pageWrappers.get(pageNumber)
      if (!wrapper) return

      const stageRect = this.stage.getBoundingClientRect()
      const wrapperRect = wrapper.getBoundingClientRect()
      const top = this.stage.scrollTop + wrapperRect.top - stageRect.top - 12
      this.stage.scrollTo({ top: Math.max(0, top), behavior: smooth ? 'smooth' : 'auto' })
    }

    private scheduleCurrentPageUpdate() {
      if (this.scrollRaf) return

      this.scrollRaf = window.requestAnimationFrame(() => {
        this.scrollRaf = 0
        this.updateCurrentPageFromScroll()
      })
    }

    private updateCurrentPageFromScroll() {
      if (!this.stage || this.pageWrappers.size === 0) return

      const stageRect = this.stage.getBoundingClientRect()
      const stageCenter = stageRect.top + stageRect.height * 0.48
      let closestPage = this.pageNumber
      let closestDistance = Number.POSITIVE_INFINITY

      this.pageWrappers.forEach((wrapper, pageNumber) => {
        const rect = wrapper.getBoundingClientRect()
        if (rect.bottom < stageRect.top || rect.top > stageRect.bottom) return

        const pageCenter = rect.top + rect.height / 2
        const distance = Math.abs(pageCenter - stageCenter)
        if (distance < closestDistance) {
          closestDistance = distance
          closestPage = pageNumber
        }
      })

      if (closestPage === this.pageNumber) return
      this.pageNumber = closestPage
      this.updateControls()
      this.setStatus(`Page ${this.pageNumber} of ${this.pageCount}`)
      this.renderVisiblePages()
    }

    private getScaleForPage(pageWidth: number) {
      return this.scaleMode === 'fit-width' ? this.getFitScale(pageWidth) : this.scale
    }

    private getFitScale(pageWidth: number) {
      const availableWidth = Math.max(240, (this.stage?.clientWidth ?? pageWidth) - 48)
      return clamp(availableWidth / pageWidth, MIN_SCALE, MAX_SCALE)
    }

    private getRenderKey(pageNumber: number, scale: number, width: number, height: number) {
      return [
        pageNumber,
        this.scaleMode,
        scale.toFixed(4),
        this.rotation,
        Math.round(width),
        Math.round(height)
      ].join(':')
    }

    private cancelRenderTasks() {
      this.renderTasks.forEach((task) => task.cancel())
      this.renderTasks.clear()
    }

    private setBusy(isBusy: boolean) {
      this.toggleAttribute('aria-busy', isBusy)
      this.classList.toggle('is-loading', isBusy)
      this.updateControls(isBusy)
    }

    private setStatus(message: string) {
      this.removeAttribute('data-error')
      if (this.statusEl) this.statusEl.textContent = message
    }

    private setError(message: string) {
      this.setAttribute('data-error', 'true')
      this.setBusy(false)
      if (this.statusEl) this.statusEl.textContent = message
    }

    private updateControls(isBusy = false) {
      if (this.pageInput) {
        this.pageInput.max = this.pageCount ? String(this.pageCount) : '1'
        this.pageInput.value = String(this.pageNumber)
        this.pageInput.disabled = isBusy || !this.pdf
      }
      if (this.prevButton) this.prevButton.disabled = isBusy || !this.pdf || this.pageNumber <= 1
      if (this.nextButton)
        this.nextButton.disabled = isBusy || !this.pdf || this.pageNumber >= this.pageCount
      if (this.zoomOutButton)
        this.zoomOutButton.disabled = isBusy || !this.pdf || this.scale <= MIN_SCALE
      if (this.zoomInButton)
        this.zoomInButton.disabled = isBusy || !this.pdf || this.scale >= MAX_SCALE
      if (this.fitButton) this.fitButton.disabled = isBusy || !this.pdf
      if (this.rotateButton) this.rotateButton.disabled = isBusy || !this.pdf
      if (this.scaleLabel) {
        const prefix = this.scaleMode === 'fit-width' ? 'Fit ' : ''
        this.scaleLabel.textContent = `${prefix}${Math.round(this.scale * 100)}%`
      }
    }

    private formatError(error: unknown) {
      return error instanceof Error ? error.message : String(error)
    }

    private isCancelError(error: unknown) {
      return error instanceof Error && /cancel/i.test(error.message)
    }
  }

  if (!customElements.get('pdf-js-viewer')) {
    customElements.define('pdf-js-viewer', PdfJsViewer)
  }
</script>

<style>
  .pdf-viewer {
    margin: 1.75rem 0;
    overflow: hidden;
    border: 1px solid hsl(var(--border));
    border-radius: 0.75rem;
    background: hsl(var(--background));
    box-shadow: 0 16px 44px hsl(var(--foreground) / 0.08);
  }

  pdf-js-viewer {
    display: block;
  }

  .pdf-viewer__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem;
    border-bottom: 1px solid hsl(var(--border));
    background: hsl(var(--muted) / 0.35);
  }

  .pdf-viewer__title {
    min-width: 10rem;
    display: grid;
    gap: 0.15rem;
    color: hsl(var(--foreground));
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .pdf-viewer__meta {
    color: hsl(var(--muted-foreground));
    font-size: 0.76rem;
    font-weight: 500;
  }

  .pdf-viewer__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem;
  }

  .pdf-viewer button {
    height: 2rem;
    min-width: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.45rem;
    background: hsl(var(--background));
    color: hsl(var(--foreground));
    padding: 0 0.62rem;
    font: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      background-color 160ms ease;
  }

  .pdf-viewer button:not(:disabled) {
    cursor: pointer;
  }

  .pdf-viewer button:hover:not(:disabled) {
    border-color: hsl(var(--primary));
    color: hsl(var(--primary));
  }

  .pdf-viewer button:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .pdf-viewer__page {
    height: 2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.45rem;
    background: hsl(var(--background));
    padding: 0 0.55rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.78rem;
    font-weight: 600;
  }

  .pdf-viewer__page input {
    width: 3rem;
    border: 0;
    border-radius: 0.25rem;
    background: transparent;
    color: hsl(var(--foreground));
    font: inherit;
    text-align: center;
  }

  .pdf-viewer__page input:focus {
    outline: 2px solid hsl(var(--primary) / 0.35);
    outline-offset: 2px;
  }

  .pdf-viewer__divider {
    width: 1px;
    height: 1.5rem;
    background: hsl(var(--border));
  }

  .pdf-viewer__status {
    min-height: 2.25rem;
    display: flex;
    align-items: center;
    border-bottom: 1px solid hsl(var(--border));
    padding: 0 0.9rem;
