---
import { Image } from 'astro:assets'
import { Icon } from 'astro-pure/user'
import type { ComponentProps } from 'astro/types'

type IconName = ComponentProps<typeof Icon>['name']

interface Props {
  publication: {
    title: string
    authors: string[]
    year: string
    journal: string
    image?: string
    imageFit?: 'cover' | 'contain'
    links: Array<{
      name: string
      href: string
      icon: IconName
    }>
  }
}

const { publication } = Astro.props

const projectLink = publication.links.find(link => link.name === 'Project')
const paperLink = publication.links.find(link => link.name === 'Paper' || link.name === 'PDF')
const titleLink = projectLink?.href || paperLink?.href || '#'

// Import all publication images using glob
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/content/publication/imgs/*.{jpeg,jpg,png,gif,avif,webp}'
)
---

<article class='publication-card group relative overflow-hidden rounded-2xl border bg-background transition-all hover:border-foreground/25 hover:shadow-md'>
  <div class='flex flex-col md:flex-row'>
    {/* 左侧图片 */}
    <div class='publication-image-wrapper w-full md:w-64 lg:w-72 flex-shrink-0'>
      <div class='relative aspect-[4/3] md:aspect-auto md:h-full overflow-hidden bg-muted' style={publication.imageFit === 'contain' ? 'background-color: white;' : undefined}>
        {publication.image && images[publication.image] ? (
          <Image
            src={images[publication.image]()}
            alt={publication.title}
            class='absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105'
            style={publication.imageFit === 'contain' ? 'object-fit: contain;' : undefined}
            loading='lazy'
          />
        ) : (
          <div class='absolute inset-0 flex items-center justify-center text-muted-foreground'>
            <Icon name='document' class='h-16 w-16 opacity-50' />
          </div>
        )}
      </div>
    </div>

    {/* 右侧内容 */}
    <div class='flex flex-1 flex-col justify-between p-4 md:p-5'>
      <div>
        {/* 标题 */}
        <a href={titleLink} target='_blank' rel='noopener noreferrer' class='block'>
          <h3 class='mb-2 text-base font-semibold leading-tight text-foreground transition-colors group-hover:text-primary md:text-lg'>
            {publication.title}
          </h3>
        </a>

          {/* 作者 */}
          <p class='mb-2 text-sm text-muted-foreground'>
            {publication.authors.map((author, index) => {
              const isMe = author.replace(/\*$/, '') === 'Haoran Liao';
              const hasStar = author.endsWith('*');
              const name = author.replace(/\*$/, '');
              return (
                <span style='position: relative; display: inline-block;'>
                  {isMe ? (
                    <span class='font-semibold text-foreground'>
                      {name}
                      {hasStar && <sup style='font-size: 0.7em; top: -0.6em; left: 0.1em; position: relative;'>*</sup>}
                    </span>
                  ) : (
                    <>
                      {name}
                      {hasStar && <sup style='font-size: 0.7em; top: -0.6em; left: 0.1em; position: relative;'>*</sup>}
                    </>
                  )}
                  {index < publication.authors.length - 1 && ', '}
                </span>
              );
            })}
          </p>

          {/* 期刊/会议 */}
          <p class='mb-3 text-sm italic text-muted-foreground'>{publication.journal}</p>
        </div>

        {/* 链接按钮 */}
        <div class='flex flex-wrap gap-2'>
          {publication.links.map((link) => (
            <a
              href={link.href}
              class='inline-flex items-center gap-1.5 rounded-lg border border-border bg-background px-3 py-1.5 text-sm font-medium transition-all hover:border-primary hover:bg-muted hover:text-primary'
              target='_blank'
              rel='noopener noreferrer'
            >
              <Icon name={link.icon} class='h-4 w-4' />
              {link.name}
            </a>
          ))}
        </div>
      </div>
    </a>
</article>

<style>
  .publication-card {
    --transition-duration: 0.3s;
  }

  .publication-image-wrapper {
    position: relative;
  }

  /* 移动端优化 */
  @media (max-width: 768px) {
    .publication-image-wrapper {
      border-bottom: 1px solid hsl(var(--border));
    }
  }

  /* 桌面端优化 */
  @media (min-width: 768px) {
    .publication-image-wrapper {
      border-right: 1px solid hsl(var(--border));
    }
  }
</style>
