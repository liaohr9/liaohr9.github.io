---
import { Button, Collapse, Spoiler, Timeline } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import Substats from '@/components/about/Substats.astro'
import ToolSection from '@/components/about/ToolSection.astro'
import EducationCard from '@/components/about/EducationCard.astro'
import ExperienceCard from '@/components/about/ExperienceCard.astro'
import sysuLogo from '@/content/about/sysu.png'
import iseeLogo from '@/content/about/isee.png'
import galbotLogo from '@/content/about/galbot.jpeg'

const headings = [
  { depth: 2, slug: 'research-interests', text: 'Research Interests' },
  { depth: 2, slug: 'education', text: 'Education' },
  { depth: 2, slug: 'research-experience', text: 'Research Experience' },
  { depth: 2, slug: 'beyond-research', text: 'Beyond Research' },
  { depth: 2, slug: 'tools', text: 'Tools' },
]
---

<!-- <PageLayout title='About' {headings} comment> -->
<PageLayout title='About' {headings}>
  <p>Hi there! I'm Haoran Liao, a Computer Science student at <b>Sun Yat-sen University</b>, passionate about pushing the boundaries of robotics and artificial intelligence.</p>
  
  <p>
    I'm driven by curiosity and a relentless pursuit of excellence. Beyond staying on top of cutting-edge technologies, I'm deeply committed to understanding their fundamental principles. I believe in learning by doing — identifying real-world problems, defining them clearly, and iterating solutions through hands-on practice.
  </p>
  
  <p>
    My motto: <b>Stay hungry, Stay foolish.</b>
  </p>

  {/* Research Interests */}
  <h2 id='research-interests'>Research Interests</h2>
  <p>
    My research interests lie in <b>Robotics and Embodied AI</b>, with a primary focus on <b>dexterous manipulation</b>. Nowadays, I gradually expand my research interests to more general topics, such as <b>World Models</b>. 
  </p>
  <p>
    My ultimate research goal is to enable robots to truly integrate into human society, genuinely assist humanity, and effectively liberate people from tedious tasks. 
  </p>

  {/* Education */}
  <h2 id='education'>Education</h2>
  <EducationCard
    logo={sysuLogo}
    school='Sun Yat-sen University (SYSU)'
    degree='B.Eng. from School of Computer Science and Engineering'
    period='2023.9 - Present (Expected 2027.7)'
    grades='4.3123 / 5   (Rank 2/353) (0.5%)'
    link='https://www.sysu.edu.cn'
  />

  {/* Research Experience */}
  <h2 id='research-experience'>Research Experience</h2>
  <div class='flex flex-col gap-3'>
    <ExperienceCard
      logo={iseeLogo}
      title='Undergraduate Research Assistant'
      org='Intelligence Science and System Lab (iSEE), Sun Yat-sen University'
      period='2023 - Present'
      advisor='Prof. Weishi Zheng'
      link='https://isee.sysu.edu.cn/'
    />
    <ExperienceCard
      logo={galbotLogo}
      title='Research Assistant'
      org='Galbot (Beijing), EPIC Lab (Peking University)'
      period='2026 - Present'
      advisor='Prof. He Wang, Prof. Li Yi'
      link='https://epic.pku.edu.cn/'
    />
  </div>

  {/* Beyond Research */}
  <h2 id='beyond-research'>Beyond Research</h2>
  <p>
    Outside of research, I maintain a passionate engagement with life in various forms:
  </p>
  <ul>
    <li>
      <b>Photography</b> — I love capturing my unique perspective of the world through the lens, documenting moments that matter to me.{' '}
      <a href='/life/photograph' class='inline-flex items-center gap-x-0.5 font-medium underline-offset-2 hover:underline'>
        View my albums
        <svg xmlns='http://www.w3.org/2000/svg' class='inline h-3.5 w-3.5' fill='none' viewBox='0 0 24 24' stroke='currentColor'>
          <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9 5l7 7-7 7' />
        </svg>
      </a>
    </li>
    <li><b>Sports</b> — I'm an active athlete who enjoys badminton, running, and swimming to maintain both physical and mental wellness</li>
    <li><b>Music</b> — A devoted rock music enthusiast! I was in a band during high school and still rock out to Green Day, Guns N' Roses, and other legendary rock bands</li>
  </ul>

