      <Section title='Skills'>
        <SkillLayout title='Programming Languages' skills={languages} />
        <SkillLayout title='Frameworks & Tools' skills={frontend} />
        <SkillLayout title='Research Areas' skills={backend} />
      </Section>
    </div>
    <Quote class='mt-12' />
  </main>
