---
import { Image } from 'astro:assets'

import { Quote } from 'astro-pure/advanced'
import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button, Card, Icon, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import ProjectCard from '@/components/home/ProjectCard.astro'
import PublicationCard from '@/components/home/PublicationCard.astro'
import Section from '@/components/home/Section.astro'
import SkillLayout from '@/components/home/SkillLayout.astro'
import config from '@/site-config'
import { publications } from '@/content/publication/publications'

const languages = ['Python', 'C/C++', 'JavaScript', 'Shell']
const frontend = ['PyTorch', 'TensorFlow', 'OpenCV', 'ROS']
const backend = ['Computer Vision', 'Machine Learning', 'Robotics']

const MAX_PUBLICATIONS = 15
// 按年份排序论文 (从新到旧)
const publicationsByDate = [...publications].sort((a, b) => parseInt(b.year) - parseInt(a.year)).slice(0, MAX_PUBLICATIONS)

const imagePath = config.logo.src
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/content/homepage/imgs/*.{jpeg,jpg,png,gif,avif,webp}'
)
if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/content/homepage/imgs/*.{jpeg,jpg,png,gif,avif,webp}"`
  )
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#659EB9'>
  <main class='flex w-full flex-col items-center'>
    <section class='animate mb-10 flex flex-col items-center gap-y-7' id='content-header'>
      <Image
        src={images[imagePath]()}
        alt={config.logo.alt || 'Logo'}
        class='h-52 w-auto rounded-full border p-1'
        loading='eager'
        fetchpriority='high'
      />

      <div class='flex flex-col items-center gap-y-4'>
        <h1 class='text-3xl font-bold'>{config.author}</h1>
        <div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
          <Label title='Guangzhou, China'>
            <Icon name='location' class='size-5' slot='icon' />
          </Label>
          <Label
            title='Source code'
            as='a'
            href='https://github.com/cworld1/astro-theme-pure'
            target='_blank'
          >
            <Icon name='github' class='size-5' slot='icon' />
          </Label>
        </div>
      </div>


    <div id='content' class='animate flex flex-col gap-y-10 md:w-[95%] lg:w-[94%] xl:w-[90%]'>
      <Section title='About'>
        <p class='text-muted-foreground'>Undergraduate Student / Researcher</p>
        <p class='text-muted-foreground'>
          I am an undergraduate student majoring in Computer Science at Sun Yat-sen University. My research interests lie at the intersection of robotics, computer vision, and machine learning. I am particularly passionate about developing intelligent systems that can understand and interact with the physical world through advanced perception and manipulation capabilities.
        </p>
        <Button title='More about me' class='w-fit self-end' href='/about' variant='ahead' />
      </Section>

      <Section title='Education'>
        <Card
          as='a'
          heading='Bachelor of Computer Science and Engineering'
          subheading='Sun Yat-sen University (SYSU)'
          date='2023 - Present (Expected 2027)'
          href='https://www.sysu.edu.cn'
        >
          <ul class='ms-4 list-disc text-muted-foreground'>
            <li>
              Intern Undergraduate at Intelligence Science and System Lab (iSEE), advised by Wei-shi Zheng.
            </li>
          </ul>
        </Card>
      </Section>

      {
        publicationsByDate.length > 0 && (
          <Section title='Publications'>
            <ul class='flex flex-col gap-y-3'>
              {publicationsByDate.map((pub) => (
                <li>
                  <PublicationCard publication={pub} />
                </li>
              ))}
            </ul>
            <Button title='More publications' class='w-fit self-end' href='/publications' variant='ahead' />
          </Section>
        )
      }

      <!-- {
        allPostsByDate.length > 0 && (
          <Section title='Posts'>
            <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
              {allPostsByDate.map((p) => (
                <li class='flex flex-col gap-x-2 sm:flex-row'>
                  <PostPreview post={p} />
                </li>
              ))}
            </ul>
            <Button title='More posts' class='w-fit self-end' href='/blog' variant='ahead' />
          </Section>
        )
      } -->
