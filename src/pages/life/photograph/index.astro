---
import { getImage } from 'astro:assets'
import sharp from 'sharp'
import * as nodePath from 'node:path'
import BaseLayout from '@/layouts/BaseLayout.astro'

interface PhotoData {
  file: string
  title?: string
  description?: string
}

interface AlbumType {
  title: string
  description?: string
  date?: string
  cover?: string
  photos: PhotoData[]
}

interface ProcessedPhoto {
  file: string
  title?: string
  description?: string
  lqip: string       // base64 data URL for blur placeholder
  thumbnailSrc: string
  fullSrc: string
  width: number
  height: number
}

interface ProcessedAlbum {
  title: string
  description?: string
  date?: string
  slug: string
  photos: ProcessedPhoto[]
}

// Load all album modules
const albumModules = import.meta.glob<{ album: AlbumType }>(
  '/src/content/photograph/*/index.ts',
  { eager: true }
)

// Load all image metadata
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/content/photograph/*/img/*.{jpeg,jpg,png,gif,webp,avif}',
  { eager: true }
)

/** Generate a tiny base64 LQIP via Sharp (runs at build time) */
async function generateLqip(fsPath: string): Promise<string> {
  try {
    const buf = await sharp(fsPath)
      .resize({ width: 20 })
      .webp({ quality: 30 })
      .toBuffer()
    return `data:image/webp;base64,${buf.toString('base64')}`
  } catch {
    return ''
  }
}

// Process each album
const albums: ProcessedAlbum[] = await Promise.all(
  Object.entries(albumModules).map(async ([path, mod]) => {
    const match = path.match(/photograph\/(.+?)\/index\.ts/)
    const slug = match?.[1] ?? ''
    const { album } = mod

    const processedPhotos = await Promise.all(
      album.photos.map(async (photo) => {
        const imgKey = `/src/content/photograph/${slug}/img/${photo.file}`
        const metadata = allImages[imgKey]?.default
        if (!metadata) return null

        // Resolve absolute FS path from Vite virtual path
        const fsPath = nodePath.resolve(process.cwd(), imgKey.slice(1))

        const [thumbnail, full, lqip] = await Promise.all([
          getImage({ src: metadata, height: 480, format: 'webp', quality: 75 }),
          getImage({ src: metadata, width: 2400, format: 'webp', quality: 88 }),
          generateLqip(fsPath)
        ])

        return {
          file: photo.file,
          title: photo.title,
          description: photo.description,
          lqip,
          thumbnailSrc: thumbnail.src,
          fullSrc: full.src,
          width: metadata.width,
          height: metadata.height
        } as ProcessedPhoto
      })
    )

    return {
      title: album.title,
      description: album.description,
      date: album.date,
      slug,
      photos: processedPhotos.filter(Boolean) as ProcessedPhoto[]
    }
  })
)

const validAlbums = albums
  .filter((a) => a.photos.length > 0)
  .sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''))

// Serialize photo data for lightbox JS
const lightboxData = validAlbums.map((album) => ({
  slug: album.slug,
  photos: album.photos.map((p) => ({
    src: p.fullSrc,
    title: p.title ?? '',
    description: p.description ?? ''
  }))
}))
---

<BaseLayout meta={{ title: 'Photography', description: 'A visual journey through moments captured in time.' }}>
  <main class='w-full px-0'>
    <!-- Page Header -->
    <section class='animate mb-14 mt-8 flex flex-col items-center gap-y-3 text-center' id='content-header'>
      <a href='/life' class='flex items-center gap-x-1 text-xs text-muted-foreground transition-colors hover:text-foreground'>
        <svg xmlns='http://www.w3.org/2000/svg' class='h-3 w-3' fill='none' viewBox='0 0 24 24' stroke='currentColor'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M15 19l-7-7 7-7' /></svg>
        Life
      </a>
      <p class='text-sm font-medium uppercase tracking-[0.3em] text-muted-foreground'>Visual Journal</p>
      <h1 class='text-4xl font-bold tracking-tight sm:text-5xl'>Photography</h1>
      <p class='max-w-md text-base text-muted-foreground'>
        Moments preserved through the lens — stories told in light and shadow.
      </p>
    </section>

    <!-- Albums -->
    <div class='animate flex flex-col gap-y-20' id='content'>
      {validAlbums.map((album, albumIndex) => (
        <section class='album-section w-full' data-album-idx={albumIndex}>
          <!-- Album Meta -->
          <div class='mb-5 flex flex-col gap-y-1 px-4 sm:px-7 lg:px-10'>
            <div class='flex items-baseline gap-x-3'>
              <h2 class='text-xl font-semibold tracking-tight'>{album.title}</h2>
              {album.date && (
                <span class='text-xs text-muted-foreground'>{album.date}</span>
              )}
            </div>
            {album.description && (
              <p class='max-w-2xl text-sm text-muted-foreground'>{album.description}</p>
            )}
          </div>

          <!-- Film Strip -->
          <div
            class='photo-strip flex gap-x-3 overflow-x-auto pb-4 pl-4 sm:pl-7 lg:pl-10'
            style='scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;'
          >
            {album.photos.map((photo, photoIndex) => (
              <button
                class='photo-card group relative flex-none cursor-pointer overflow-hidden rounded-lg border border-border/40 bg-muted/30 transition-transform duration-300 hover:scale-[1.02] hover:shadow-xl focus:outline-none'
                style='scroll-snap-align: start; height: 62vh; min-height: 320px; max-height: 560px;'
                data-album-idx={albumIndex}
                data-photo-idx={photoIndex}
                aria-label={photo.title ?? `Photo ${photoIndex + 1}`}
              >
                <img
                  src={photo.lqip || photo.thumbnailSrc}
                  data-src={photo.thumbnailSrc}
                  alt={photo.title ?? ''}
                  class='photo-lazy h-full w-auto max-w-none object-cover'
                  style={`aspect-ratio: ${photo.width}/${photo.height}; filter: blur(12px); transform: scale(1.05); transition: filter 0.5s ease, transform 0.5s ease;`}
                />
                {/* Hover Overlay */}
                {(photo.title || photo.description) && (
                  <div class='absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-black/70 via-black/20 to-transparent p-4 opacity-0 transition-opacity duration-300 group-hover:opacity-100'>
                    {photo.title && (
                      <p class='text-sm font-semibold text-white drop-shadow'>{photo.title}</p>
                    )}
                    {photo.description && (
                      <p class='mt-0.5 text-xs text-white/80 drop-shadow'>{photo.description}</p>
                    )}
                  </div>
                )}
                {/* Click hint */}
                <div class='absolute right-3 top-3 rounded-full bg-black/30 p-1.5 opacity-0 backdrop-blur-sm transition-opacity duration-300 group-hover:opacity-100'>
                  <svg xmlns='http://www.w3.org/2000/svg' class='h-3.5 w-3.5 text-white' fill='none' viewBox='0 0 24 24' stroke='currentColor'>
                    <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7' />
                  </svg>
                </div>
              </button>
            ))}
            {/* Right padding sentinel */}
            <div class='flex-none' style='width: 2rem;' />
          </div>
        </section>
      ))}

      {validAlbums.length === 0 && (
        <div class='flex flex-col items-center gap-y-3 py-24 text-center text-muted-foreground'>
          <svg xmlns='http://www.w3.org/2000/svg' class='h-12 w-12 opacity-30' fill='none' viewBox='0 0 24 24' stroke='currentColor'>
            <path stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z' />
            <path stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M15 13a3 3 0 11-6 0 3 3 0 016 0z' />
          </svg>
          <p class='text-sm'>No albums yet. Add folders to <code>src/content/photograph/</code> to get started.</p>
        </div>
      )}
    </div>
  </main>

  <!-- ============ LIGHTBOX ============ -->
  <div
    id='lightbox'
    class='fixed inset-0 z-50 flex items-center justify-center bg-black/92 backdrop-blur-sm'
    style='display: none !important;'
    role='dialog'
    aria-modal='true'
    aria-label='Photo viewer'
  >
    <!-- Close button -->
    <button
      id='lb-close'
      class='absolute right-5 top-5 z-10 rounded-full bg-white/10 p-2.5 text-white transition-colors hover:bg-white/25'
      aria-label='Close'
    >
      <svg xmlns='http://www.w3.org/2000/svg' class='h-5 w-5' fill='none' viewBox='0 0 24 24' stroke='currentColor'>
        <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M6 18L18 6M6 6l12 12' />
      </svg>
    </button>

    <!-- Prev button -->
    <button
      id='lb-prev'
      class='absolute left-4 top-1/2 z-10 -translate-y-1/2 rounded-full bg-white/10 p-3 text-white transition-colors hover:bg-white/25 disabled:opacity-20'
      aria-label='Previous photo'
    >
      <svg xmlns='http://www.w3.org/2000/svg' class='h-6 w-6' fill='none' viewBox='0 0 24 24' stroke='currentColor'>
        <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M15 19l-7-7 7-7' />
      </svg>
    </button>

    <!-- Next button -->
    <button
      id='lb-next'
      class='absolute right-4 top-1/2 z-10 -translate-y-1/2 rounded-full bg-white/10 p-3 text-white transition-colors hover:bg-white/25 disabled:opacity-20'
      aria-label='Next photo'
    >
      <svg xmlns='http://www.w3.org/2000/svg' class='h-6 w-6' fill='none' viewBox='0 0 24 24' stroke='currentColor'>
        <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9 5l7 7-7 7' />
      </svg>
    </button>

    <!-- Image container -->
    <div class='relative flex max-h-[90dvh] max-w-[90dvw] flex-col items-center gap-y-3'>
      <img
        id='lb-img'
        src=''
        alt=''
        class='max-h-[80dvh] max-w-[88dvw] rounded-lg object-contain shadow-2xl transition-opacity duration-200'
        style='opacity: 0;'
      />
      <!-- Caption -->
      <div id='lb-caption' class='text-center'>
        <p id='lb-title' class='text-sm font-semibold text-white'></p>
        <p id='lb-desc' class='mt-0.5 text-xs text-white/70'></p>
      </div>
    </div>

    <!-- Counter -->
    <div class='absolute bottom-5 left-1/2 -translate-x-1/2 text-xs text-white/50'>
      <span id='lb-counter'></span>
    </div>
  </div>
</BaseLayout>

<!-- Pass data to client -->
<script define:vars={{ lightboxData }}>
  // ── IntersectionObserver Lazy Loading ──────────────────────────────────────
  // Native loading="lazy" doesn't work in horizontal scroll containers.
  // We store the real src in data-src and load it only when card enters viewport.
  const lazyObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return
        const img = entry.target
        const realSrc = img.dataset.src
        if (!realSrc || img.src === realSrc) {
          lazyObserver.unobserve(img)
          return
        }
        const tmp = new window.Image()
        tmp.onload = () => {
          img.src = realSrc
          // Remove blur after the real image is swapped in
          img.style.filter = 'none'
          img.style.transform = 'scale(1)'
          lazyObserver.unobserve(img)
        }
        tmp.src = realSrc
      })
    },
    {
      // rootMargin: pre-load once card is 200px from entering viewport
      rootMargin: '0px 200px 0px 200px',
      threshold: 0
    }
  )

  document.querySelectorAll('img.photo-lazy').forEach((img) => {
    lazyObserver.observe(img)
  })

  // ── Lightbox ───────────────────────────────────────────────────────────────
  const albums = lightboxData
  let currentAlbum = 0
  let currentPhoto = 0

  const lightbox = document.getElementById('lightbox')
  const lbImg = document.getElementById('lb-img')
  const lbTitle = document.getElementById('lb-title')
  const lbDesc = document.getElementById('lb-desc')
  const lbCounter = document.getElementById('lb-counter')
  const lbClose = document.getElementById('lb-close')
  const lbPrev = document.getElementById('lb-prev')
  const lbNext = document.getElementById('lb-next')

  function openLightbox(albumIdx, photoIdx) {
    currentAlbum = albumIdx
    currentPhoto = photoIdx
    renderLightbox()
    lightbox.style.removeProperty('display')
    document.body.style.overflow = 'hidden'
    lbImg.focus()
  }

  function closeLightbox() {
    lightbox.style.display = 'none'
    document.body.style.overflow = ''
  }

  function showPhoto(albumIdx, photoIdx) {
    currentAlbum = albumIdx
    currentPhoto = photoIdx
    renderLightbox()
  }

  function renderLightbox() {
    const album = albums[currentAlbum]
    if (!album) return
    const photo = album.photos[currentPhoto]
    if (!photo) return

    lbImg.style.opacity = '0'
    lbImg.onload = () => { lbImg.style.opacity = '1' }
    lbImg.src = photo.src
    lbImg.alt = photo.title || ''
    lbTitle.textContent = photo.title || ''
    lbDesc.textContent = photo.description || ''
    lbTitle.style.display = photo.title ? '' : 'none'
    lbDesc.style.display = photo.description ? '' : 'none'
    lbCounter.textContent = `${currentPhoto + 1} / ${album.photos.length}`

    const hasPrev = currentPhoto > 0
    const hasNext = currentPhoto < album.photos.length - 1
    lbPrev.disabled = !hasPrev
    lbNext.disabled = !hasNext
    lbPrev.style.opacity = hasPrev ? '1' : '0.2'
    lbNext.style.opacity = hasNext ? '1' : '0.2'
  }

  // Wire up photo cards
  document.querySelectorAll('.photo-card').forEach((card) => {
    card.addEventListener('click', () => {
      const aIdx = parseInt(card.dataset.albumIdx ?? '0')
      const pIdx = parseInt(card.dataset.photoIdx ?? '0')
      openLightbox(aIdx, pIdx)
    })
  })

  // Lightbox controls
  lbClose.addEventListener('click', closeLightbox)

  lbPrev.addEventListener('click', () => {
    if (currentPhoto > 0) showPhoto(currentAlbum, currentPhoto - 1)
  })

  lbNext.addEventListener('click', () => {
    const album = albums[currentAlbum]
    if (album && currentPhoto < album.photos.length - 1) {
      showPhoto(currentAlbum, currentPhoto + 1)
    }
  })

  // Click backdrop to close
  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox()
  })

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    if (lightbox.style.display === 'none') return
    if (e.key === 'Escape') closeLightbox()
    if (e.key === 'ArrowLeft' && currentPhoto > 0) showPhoto(currentAlbum, currentPhoto - 1)
    if (e.key === 'ArrowRight') {
      const album = albums[currentAlbum]
      if (album && currentPhoto < album.photos.length - 1) {
        showPhoto(currentAlbum, currentPhoto + 1)
      }
    }
  })

  // Touch/swipe support
  let touchStartX = 0
  lightbox.addEventListener('touchstart', (e) => {
    touchStartX = e.touches[0].clientX
  }, { passive: true })
  lightbox.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - touchStartX
    if (Math.abs(dx) < 50) return
    if (dx < 0) {
      const album = albums[currentAlbum]
      if (album && currentPhoto < album.photos.length - 1) showPhoto(currentAlbum, currentPhoto + 1)
    } else {
      if (currentPhoto > 0) showPhoto(currentAlbum, currentPhoto - 1)
    }
  }, { passive: true })
</script>

<style>
  /* Custom scrollbar for film strips */
  .photo-strip {
    scrollbar-width: thin;
    scrollbar-color: hsl(var(--border)) transparent;
  }
  .photo-strip::-webkit-scrollbar {
    height: 4px;
  }
  .photo-strip::-webkit-scrollbar-track {
    background: transparent;
  }
  .photo-strip::-webkit-scrollbar-thumb {
    background-color: hsl(var(--border));
    border-radius: 2px;
  }

  /* Lightbox fade in */
  #lightbox {
    animation: lb-fade-in 150ms ease-out both;
  }
  @keyframes lb-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>
