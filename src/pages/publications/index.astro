---
import { Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import PublicationList from '@/components/publications/PublicationList.astro'

const publications = [
  {
    title: 'Example Paper 1: Advanced Research on Something Very Interesting',
    authors: ['First Author', 'Your Name', 'Third Author'],
    year: '2024',
    journal: 'Conference of Examples (CoE 2024)',
    image: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=800&h=600&fit=crop',
    links: [
      { name: 'Paper', href: '#', icon: 'document' as const },
      { name: 'Code', href: 'https://github.com/yourusername/project', icon: 'github' as const },
      { name: 'Project', href: '#', icon: 'link' as const }
    ]
  },
  {
    title: 'Example Paper 2: Another Interesting Study on Machine Learning',
    authors: ['Your Name', 'Second Author', 'Third Author'],
    year: '2024',
    journal: 'Journal of AI Research (JAIR)',
    image: 'https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=800&h=600&fit=crop',
    links: [
      { name: 'PDF', href: '#', icon: 'document' as const },
      { name: 'Code', href: '#', icon: 'github' as const }
    ]
  },
  {
    title: 'Example Paper 3: Deep Learning Applications',
    authors: ['Your Name', 'Second Author'],
    year: '2023',
    journal: 'Journal of Examples (JoE)',
    image: 'https://images.unsplash.com/photo-1509228627152-72ae9ae6848d?w=800&h=600&fit=crop',
    links: [
      { name: 'PDF', href: '#', icon: 'document' as const },
      { name: 'Website', href: '#', icon: 'link' as const }
    ]
  },
  {
    title: 'Example Paper 4: Computer Vision Research',
    authors: ['First Author', 'Your Name'],
    year: '2023',
    journal: 'International Conference on Computer Vision (ICCV)',
    image: 'https://images.unsplash.com/photo-1485827404703-89b55fcc595e?w=800&h=600&fit=crop',
    links: [
      { name: 'Paper', href: '#', icon: 'document' as const }
    ]
  }
]

const groupedPublications = publications.reduce((acc, pub) => {
  const year = pub.year
  if (!acc[year]) acc[year] = []
  acc[year].push(pub)
  return acc
}, {} as Record<string, typeof publications>)

const years = Object.keys(groupedPublications).sort((a, b) => parseInt(b) - parseInt(a))

const headings = years.map(year => ({
  depth: 2,
  slug: year,
  text: year
}))
---

<PageLayout title='Publications' {headings} view>
  
  <p class="mb-8 text-muted-foreground">
    Research Interests: Machine Learning, Computer Vision, Natural Language Processing, and Deep Learning Applications.
  </p>

  {
    years.map((year) => (
      <div class='mb-12'>
        <h2 id={year} class='text-2xl font-bold mb-6'>{year}</h2>
        <PublicationList publications={groupedPublications[year]} />
      </div>
    ))
  }

</PageLayout>